generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                    @id @default(uuid())
  nombre                String
  slug                  String                    @unique
  createAt              DateTime                  @default(now())
  updateAt              DateTime                  @updatedAt
  activo                Boolean                   @default(true)
  roles                 Rol[]
  acompanantes          Acompañante[]
  habitaciones          Habitaciones[]
  tiposHabitacion       TiposHabitacion[]
  apartamentos          Apartamento[]
  servicios             Servicios[]
  reglas                Regla[]
  contratoReglas        ContratoRegla[]
  apartamentoServicios  ApartamentoServicios[]
  contratos             Contratos[]
  renovacionesContrato  RenovacionContrato[]
  ajustesRentaContrato  AjusteRentaContrato[]
  inventariosContrato   ContratoInventario[]
  entregasContrato      ContratoEntrega[]
  depositosGarantia     DepositoGarantia[]
  movimientosDeposito   MovimientoDepositoGarantia[]
  inquilinos            Inquilino[]
  expedientesArrendamiento ExpedienteArrendamiento[]
  referenciasArrendamiento ReferenciaArrendamiento[]
  garantesArrendamiento GaranteArrendamiento[]
  recibos               Recibos[]
  reciboDetalles        ReciboDetalles[]
  pagosRecibo           PagoRecibo[]
  promesasPago          PromesaPago[]
  recordatoriosCobranza RecordatorioCobranza[]
  rolPermisos           RolPermiso[]
  usuarios              Usuario[]
  gastosApartamento     GastoApartamento[]
  mantenimientos        MantenimientoIncidencia[]
}

model Rol {
  id          String       @id @default(uuid())
  tenantId    String
  nombre      String
  descripcion String
  createAt    DateTime     @default(now())
  updateAt    DateTime     @updatedAt
  activo      Boolean
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  permisos    RolPermiso[]
  Usuario     Usuario[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

model Acompañante {
  id             String    @id @default(uuid())
  tenantId       String
  nombreCompleto String
  inquilinoId    String
  Parentesco     String
  createAt       DateTime  @default(now())
  updateAt       DateTime  @updatedAt
  activo         Boolean
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  inquilino      Inquilino @relation(fields: [inquilinoId], references: [id])

  @@index([tenantId])
}

model Habitaciones {
  id               String          @id @default(uuid())
  tenantId         String
  apartamentoId    String
  tipoHabitacionId String
  cantidad         Int             @default(1)
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  apartamento      Apartamento     @relation(fields: [apartamentoId], references: [id])
  tipoHabitacion   TiposHabitacion @relation(fields: [tipoHabitacionId], references: [id])
  createAt         DateTime        @default(now())
  activo           Boolean
  updateAt         DateTime        @updatedAt

  @@index([tenantId])
  @@index([apartamentoId], map: "Habitaciones_apartamentoId_fkey")
  @@index([tipoHabitacionId], map: "Habitaciones_tipoHabitacionId_fkey")
}

model TiposHabitacion {
  id          String         @id @default(uuid())
  tenantId    String
  nombre      String
  createAt    DateTime       @default(now())
  updateAt    DateTime       @updatedAt
  activo      Boolean
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  apartamento Habitaciones[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

model Apartamento {
  id                   String                    @id @default(uuid())
  tenantId             String
  numero               String
  direccion            String?
  createAt             DateTime                  @default(now())
  updateAt             DateTime                  @updatedAt
  disponible           Boolean                   @default(true)
  tenant               Tenant                    @relation(fields: [tenantId], references: [id])
  apartamento          Habitaciones[]
  ApartamentoServicios ApartamentoServicios[]
  activo               Boolean
  historialOcupacion   Contratos[]               @relation("ApartamentoHistorialOcupacion")
  gastos               GastoApartamento[]
  mantenimientos       MantenimientoIncidencia[]

  @@unique([tenantId, numero])
  @@index([tenantId])
}

model Servicios {
  id                   String                 @id @default(uuid())
  tenantId             String
  nombre               String
  createAt             DateTime               @default(now())
  updateAt             DateTime               @updatedAt
  activo               Boolean
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  ApartamentoServicios ApartamentoServicios[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

model ApartamentoServicios {
  id             String      @id @default(uuid())
  tenantId       String
  apartamentoId  String
  servicioId     String
  clave          String?
  incluido       Boolean     @default(true)
  costoAdicional Decimal     @default(0.00)
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  apartamento    Apartamento @relation(fields: [apartamentoId], references: [id])
  servicio       Servicios   @relation(fields: [servicioId], references: [id])
  createAt       DateTime    @default(now())
  updateAt       DateTime    @updatedAt

  @@unique([tenantId, apartamentoId, servicioId])
  @@index([tenantId])
  @@index([apartamentoId], map: "ApartamentoServicios_apartamentoId_fkey")
  @@index([servicioId], map: "ApartamentoServicios_servicioId_fkey")
}

model Contratos {
  id                    String                    @id @default(uuid())
  tenantId              String
  inquilinoId           String
  apartamentoId         String
  fechaInicio           DateTime
  fechaFin              DateTime?
  createAt              DateTime                  @default(now())
  updateAt              DateTime                  @updatedAt
  montoMensual          Decimal                   @default(0.00)
  diaPagoMensual        Int                       @default(1)
  activo                Boolean                   @default(true)
  preavisoDias          Int                       @default(30)
  estadoRenovacion      EstadoRenovacionContrato  @default(SIN_GESTION)
  fechaUltimaRenovacion DateTime?
  fechaDesocupacion     DateTime?
  motivoCancelacion     String?
  notasCierre           String?
  tenant                Tenant                    @relation(fields: [tenantId], references: [id])
  inquilino             Inquilino                 @relation(fields: [inquilinoId], references: [id])
  apartamento           Apartamento               @relation(fields: [apartamentoId], references: [id], name: "ApartamentoHistorialOcupacion")
  recibos               Recibos[]
  mantenimientos        MantenimientoIncidencia[]
  renovaciones          RenovacionContrato[]      @relation("ContratoRenovacionesOrigen")
  ajustesRenta          AjusteRentaContrato[]
  inventarios           ContratoInventario[]
  entrega               ContratoEntrega?
  depositoGarantia      DepositoGarantia?
  reglas                ContratoRegla[]

  @@index([tenantId])
  @@index([inquilinoId], map: "Contratos_inquilinoId_fkey")
  @@index([apartamentoId], map: "Contratos_apartamentoId_fkey")
  @@index([fechaFin])
  @@index([estadoRenovacion])
}

model Regla {
  id          String          @id @default(uuid())
  tenantId    String
  nombre      String
  descripcion String?
  createAt    DateTime        @default(now())
  updateAt    DateTime        @updatedAt
  activo      Boolean         @default(true)
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  contratos   ContratoRegla[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

model ContratoRegla {
  id         String    @id @default(uuid())
  tenantId   String
  contratoId String
  reglaId    String
  createAt   DateTime  @default(now())
  updateAt   DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  contrato   Contratos @relation(fields: [contratoId], references: [id])
  regla      Regla     @relation(fields: [reglaId], references: [id])

  @@unique([tenantId, contratoId, reglaId])
  @@index([tenantId])
  @@index([contratoId])
  @@index([reglaId])
}

model Inquilino {
  id                     String                      @id @default(uuid())
  tenantId               String
  nombreCompleto         String
  dni                    String
  numero                 String
  correo                 String
  fechaNacimiento        DateTime                    @db.DateTime(6) // armada a partir de "Dia"/"Mes"/"Año"
  createAt               DateTime                    @default(now())
  updateAt               DateTime                    @updatedAt
  activo                 Boolean
  tenant                 Tenant                      @relation(fields: [tenantId], references: [id])
  Acompañante            Acompañante[]
  Contratos              Contratos[]
  expedienteArrendamiento ExpedienteArrendamiento?

  @@unique([tenantId, dni])
  @@unique([tenantId, correo])
  @@index([tenantId])
}

model ExpedienteArrendamiento {
  id                         String                           @id @default(uuid())
  tenantId                   String
  inquilinoId                String                           @unique
  ocupacion                  String?
  empresa                    String?
  ingresosMensuales          Decimal?                         @db.Decimal(10, 2)
  historialAlquiler          String?
  motivoSolicitud            String?
  estadoDecision            EstadoDecisionArrendamiento      @default(PENDIENTE)
  decisionTomadaPor          String?
  fechaDecision              DateTime?
  motivoDecision             String?
  createAt                   DateTime                         @default(now())
  updateAt                   DateTime                         @updatedAt
  tenant                     Tenant                           @relation(fields: [tenantId], references: [id])
  inquilino                  Inquilino                        @relation(fields: [inquilinoId], references: [id])
  referencias                ReferenciaArrendamiento[]
  garantes                   GaranteArrendamiento[]

  @@index([tenantId])
  @@index([estadoDecision])
}

model ReferenciaArrendamiento {
  id                         String                         @id @default(uuid())
  tenantId                   String
  expedienteArrendamientoId  String
  tipo                       TipoReferenciaArrendamiento
  nombreCompleto             String
  telefono                   String
  correo                     String?
  relacion                   String?
  notas                      String?
  createAt                   DateTime                       @default(now())
  updateAt                   DateTime                       @updatedAt
  tenant                     Tenant                         @relation(fields: [tenantId], references: [id])
  expedienteArrendamiento    ExpedienteArrendamiento        @relation(fields: [expedienteArrendamientoId], references: [id])

  @@index([tenantId])
  @@index([expedienteArrendamientoId])
}

model GaranteArrendamiento {
  id                         String                         @id @default(uuid())
  tenantId                   String
  expedienteArrendamientoId  String
  nombreCompleto             String
  dni                        String
  telefono                   String
  correo                     String?
  empresa                    String?
  ingresosMensuales          Decimal?                       @db.Decimal(10, 2)
  notas                      String?
  createAt                   DateTime                       @default(now())
  updateAt                   DateTime                       @updatedAt
  tenant                     Tenant                         @relation(fields: [tenantId], references: [id])
  expedienteArrendamiento    ExpedienteArrendamiento        @relation(fields: [expedienteArrendamientoId], references: [id])

  @@index([tenantId])
  @@index([expedienteArrendamientoId])
}

model Recibos {
  id                    String                 @id @default(uuid())
  tenantId              String
  contratoId            String
  fechaPago             DateTime
  fechaVencimiento      DateTime
  estado                EstadoRecibo           @default(PENDIENTE)
  total                 Decimal                @default(0.00)
  cargoMora             Decimal                @default(0.00)
  saldoPendiente        Decimal                @default(0.00)
  observacionesCobranza String?
  createAt              DateTime               @default(now())
  updateAt              DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  contrato              Contratos              @relation(fields: [contratoId], references: [id])
  detalles              ReciboDetalles[]
  pagosParciales        PagoRecibo[]
  promesasPago          PromesaPago[]
  recordatorios         RecordatorioCobranza[]

  @@index([tenantId])
  @@index([contratoId], map: "Recibos_contratoId_fkey")
  @@index([estado, fechaVencimiento])
}

model ReciboDetalles {
  id          String   @id @default(uuid())
  tenantId    String
  reciboId    String
  descripcion String
  monto       Decimal  @default(0.00)
  createAt    DateTime @default(now())
  updateAt    DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  recibo      Recibos  @relation(fields: [reciboId], references: [id])

  @@index([tenantId])
  @@index([reciboId], map: "ReciboDetalles_reciboId_fkey")
}

model PagoRecibo {
  id         String   @id @default(uuid())
  tenantId   String
  reciboId   String
  fechaPago  DateTime
  monto      Decimal  @default(0.00)
  referencia String?
  nota       String?
  createAt   DateTime @default(now())
  updateAt   DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  recibo     Recibos  @relation(fields: [reciboId], references: [id])

  @@index([tenantId])
  @@index([reciboId])
}

model PromesaPago {
  id                String    @id @default(uuid())
  tenantId          String
  reciboId          String
  fechaPrometida    DateTime
  montoPrometido    Decimal   @default(0.00)
  nota              String?
  cumplida          Boolean   @default(false)
  fechaCumplimiento DateTime?
  createAt          DateTime  @default(now())
  updateAt          DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  recibo            Recibos   @relation(fields: [reciboId], references: [id])

  @@index([tenantId])
  @@index([reciboId])
  @@index([fechaPrometida])
}

model RecordatorioCobranza {
  id           String            @id @default(uuid())
  tenantId     String
  reciboId     String
  canal        CanalRecordatorio
  destinatario String
  mensaje      String
  enviadoAt    DateTime          @default(now())
  createAt     DateTime          @default(now())
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  recibo       Recibos           @relation(fields: [reciboId], references: [id])

  @@index([tenantId])
  @@index([reciboId])
  @@index([canal, enviadoAt])
}

enum EstadoRecibo {
  PENDIENTE
  PAGADO
  VENCIDO
  PARCIALMENTE_PAGADO
}

enum CanalRecordatorio {
  WHATSAPP
  EMAIL
}

enum EstadoRenovacionContrato {
  SIN_GESTION
  ALERTA_GENERADA
  EN_NEGOCIACION
  RENOVADO
  NO_RENOVADO
}

enum TipoInventarioContrato {
  ENTRADA
  SALIDA
}

enum EstadoDepositoGarantia {
  PENDIENTE
  RECIBIDO
  PARCIALMENTE_DEVUELTO
  APLICADO
  DEVUELTO
}

enum TipoMovimientoDepositoGarantia {
  RECIBIDO
  APLICADO_DANOS
  APLICADO_SALDO_PENDIENTE
  DEVOLUCION_PARCIAL
  DEVOLUCION_TOTAL
  AJUSTE
}

model RenovacionContrato {
  id                  String                   @id @default(uuid())
  tenantId            String
  contratoId          String
  fechaGestion        DateTime                 @default(now())
  fechaInicioRenovada DateTime
  fechaFinRenovada    DateTime?
  montoAnterior       Decimal                  @default(0.00)
  montoNuevo          Decimal                  @default(0.00)
  porcentajeAjuste    Decimal                  @default(0.00)
  estado              EstadoRenovacionContrato @default(RENOVADO)
  notas               String?
  createAt            DateTime                 @default(now())
  updateAt            DateTime                 @updatedAt
  tenant              Tenant                   @relation(fields: [tenantId], references: [id])
  contrato            Contratos                @relation("ContratoRenovacionesOrigen", fields: [contratoId], references: [id])

  @@index([tenantId])
  @@index([contratoId])
  @@index([fechaGestion])
}

model AjusteRentaContrato {
  id               String    @id @default(uuid())
  tenantId         String
  contratoId       String
  fechaAplicacion  DateTime
  montoAnterior    Decimal   @default(0.00)
  montoNuevo       Decimal   @default(0.00)
  porcentajeAjuste Decimal   @default(0.00)
  motivo           String?
  createAt         DateTime  @default(now())
  updateAt         DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  contrato         Contratos @relation(fields: [contratoId], references: [id])

  @@index([tenantId])
  @@index([contratoId])
  @@index([fechaAplicacion])
}

model ContratoInventario {
  id            String                 @id @default(uuid())
  tenantId      String
  contratoId    String
  tipo          TipoInventarioContrato
  fechaRegistro DateTime               @default(now())
  observaciones String?
  items         Json
  createAt      DateTime               @default(now())
  updateAt      DateTime               @updatedAt
  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  contrato      Contratos              @relation(fields: [contratoId], references: [id])

  @@unique([contratoId, tipo])
  @@index([tenantId])
  @@index([contratoId])
}

model ContratoEntrega {
  id                String    @id @default(uuid())
  tenantId          String
  contratoId        String    @unique
  fechaEntrega      DateTime
  estadoInmueble    String
  cargosDanos       Decimal   @default(0.00)
  saldoPendiente    Decimal   @default(0.00)
  motivoCancelacion String?
  observaciones     String?
  createAt          DateTime  @default(now())
  updateAt          DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  contrato          Contratos @relation(fields: [contratoId], references: [id])

  @@index([tenantId])
  @@index([fechaEntrega])
}

model DepositoGarantia {
  id                     String                 @id @default(uuid())
  tenantId               String
  contratoId             String                 @unique
  monto                  Decimal                @default(0.00)
  fechaRecepcion         DateTime?
  estado                 EstadoDepositoGarantia @default(PENDIENTE)
  montoDevuelto          Decimal                @default(0.00)
  montoAplicadoDanos     Decimal                @default(0.00)
  montoAplicadoSaldo     Decimal                @default(0.00)
  saldoRetenido          Decimal                @default(0.00)
  reciboRecepcion        String?
  reciboLiquidacion      String?
  observaciones          String?
  createAt               DateTime               @default(now())
  updateAt               DateTime               @updatedAt
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id])
  contrato               Contratos              @relation(fields: [contratoId], references: [id])
  movimientos            MovimientoDepositoGarantia[]

  @@index([tenantId])
  @@index([estado])
  @@index([fechaRecepcion])
}

model MovimientoDepositoGarantia {
  id                 String                         @id @default(uuid())
  tenantId           String
  depositoGarantiaId String
  fecha              DateTime                       @default(now())
  tipo               TipoMovimientoDepositoGarantia
  monto              Decimal                        @default(0.00)
  descripcion        String?
  createAt           DateTime                       @default(now())
  updateAt           DateTime                       @updatedAt
  tenant             Tenant                         @relation(fields: [tenantId], references: [id])
  depositoGarantia   DepositoGarantia               @relation(fields: [depositoGarantiaId], references: [id])

  @@index([tenantId])
  @@index([depositoGarantiaId])
  @@index([fecha])
  @@index([tipo])
}

model GastoApartamento {
  id             String         @id @default(uuid())
  tenantId       String
  apartamentoId  String
  fecha          DateTime
  categoria      CategoriaGasto
  concepto       String
  descripcion    String?
  monto          Decimal        @default(0.00)
  extraordinario Boolean        @default(false)
  createAt       DateTime       @default(now())
  updateAt       DateTime       @updatedAt
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  apartamento    Apartamento    @relation(fields: [apartamentoId], references: [id])

  @@index([tenantId])
  @@index([apartamentoId])
  @@index([fecha])
  @@index([categoria])
}

enum CategoriaGasto {
  MANTENIMIENTO
  REPARACION
  SERVICIO_DUENO
  LIMPIEZA
  MOBILIARIO
  COMISION
  IMPUESTO
  EXTRAORDINARIO
  OTRO
}

enum TipoMantenimiento {
  TICKET
  DANIO_REPORTADO
  PREVENTIVO
  CORRECTIVO
}

enum OrigenMantenimiento {
  INQUILINO
  ADMINISTRACION
  INSPECCION
  PROPIETARIO
}

enum EstadoMantenimiento {
  REPORTADO
  EN_PROCESO
  RESUELTO
}

model MantenimientoIncidencia {
  id                   String              @id @default(uuid())
  tenantId             String
  apartamentoId        String
  contratoId           String?
  tipo                 TipoMantenimiento
  origen               OrigenMantenimiento @default(ADMINISTRACION)
  titulo               String
  descripcion          String
  proveedorAsignado    String?
  costoEstimado        Decimal             @default(0.00)
  costoReal            Decimal?
  fechaReporte         DateTime            @default(now())
  fechaAtencion        DateTime?
  afectaDisponibilidad Boolean             @default(false)
  estado               EstadoMantenimiento @default(REPORTADO)
  createAt             DateTime            @default(now())
  updateAt             DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  apartamento          Apartamento         @relation(fields: [apartamentoId], references: [id])
  contrato             Contratos?          @relation(fields: [contratoId], references: [id])

  @@index([tenantId])
  @@index([apartamentoId])
  @@index([contratoId])
  @@index([estado, fechaReporte])
  @@index([tipo])
}

model Permiso {
  id               String       @id @default(uuid())
  nombre           String       @unique
  descripcion      String
  createAt         DateTime     @default(now())
  updateAt         DateTime     @updatedAt
  activo           Boolean
  esPermisoSistema Boolean      @default(false)
  roles            RolPermiso[]
}

model RolPermiso {
  id        String   @id @default(uuid())
  tenantId  String
  rolId     String
  permisoId String
  createAt  DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  permiso   Permiso  @relation(fields: [permisoId], references: [id])
  rol       Rol      @relation(fields: [rolId], references: [id])

  @@unique([tenantId, rolId, permisoId])
  @@index([tenantId])
  @@index([permisoId], map: "RolPermiso_permisoId_fkey")
}

enum TipoUsuario {
  ROOT
  TENANT_ADMIN
}

model Usuario {
  id          String      @id @default(uuid())
  tenantId    String
  nombre      String
  email       String
  password    String
  createAt    DateTime    @default(now())
  updateAt    DateTime    @updatedAt
  activo      Boolean
  rolId       String
  DebeCambiar Boolean
  tipoUsuario TipoUsuario @default(TENANT_ADMIN)
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  rol         Rol         @relation(fields: [rolId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([rolId], map: "Usuario_rolId_fkey")
}


enum TipoReferenciaArrendamiento {
  PERSONAL
  LABORAL
  ARRENDADOR_ANTERIOR
}

enum EstadoDecisionArrendamiento {
  PENDIENTE
  APROBADO
  RECHAZADO
}
