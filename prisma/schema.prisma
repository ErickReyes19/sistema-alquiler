generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(uuid())
  nombre                String
  slug                  String                 @unique
  createAt              DateTime               @default(now())
  updateAt              DateTime               @updatedAt
  activo                Boolean                @default(true)
  roles                 Rol[]
  acompanantes          Acompañante[]
  habitaciones          Habitaciones[]
  tiposHabitacion       TiposHabitacion[]
  apartamentos          Apartamento[]
  servicios             Servicios[]
  apartamentoServicios  ApartamentoServicios[]
  contratos             Contratos[]
  inquilinos            Inquilino[]
  recibos               Recibos[]
  reciboDetalles        ReciboDetalles[]
  pagosRecibo           PagoRecibo[]
  promesasPago          PromesaPago[]
  recordatoriosCobranza RecordatorioCobranza[]
  permisos              Permiso[]
  rolPermisos           RolPermiso[]
  usuarios              Usuario[]
  gastosApartamento     GastoApartamento[]
}

model Rol {
  id          String       @id @default(uuid())
  tenantId    String
  nombre      String
  descripcion String
  createAt    DateTime     @default(now())
  updateAt    DateTime     @updatedAt
  activo      Boolean
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  permisos    RolPermiso[]
  Usuario     Usuario[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

model Acompañante {
  id             String    @id @default(uuid())
  tenantId       String
  nombreCompleto String
  inquilinoId    String
  Parentesco     String
  createAt       DateTime  @default(now())
  updateAt       DateTime  @updatedAt
  activo         Boolean
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  inquilino      Inquilino @relation(fields: [inquilinoId], references: [id])

  @@index([tenantId])
}

model Habitaciones {
  id               String          @id @default(uuid())
  tenantId         String
  apartamentoId    String
  tipoHabitacionId String
  cantidad         Int             @default(1)
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  apartamento      Apartamento     @relation(fields: [apartamentoId], references: [id])
  tipoHabitacion   TiposHabitacion @relation(fields: [tipoHabitacionId], references: [id])
  createAt         DateTime        @default(now())
  activo           Boolean
  updateAt         DateTime        @updatedAt

  @@index([tenantId])
  @@index([apartamentoId], map: "Habitaciones_apartamentoId_fkey")
  @@index([tipoHabitacionId], map: "Habitaciones_tipoHabitacionId_fkey")
}

model TiposHabitacion {
  id          String         @id @default(uuid())
  tenantId    String
  nombre      String
  createAt    DateTime       @default(now())
  updateAt    DateTime       @updatedAt
  activo      Boolean
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  apartamento Habitaciones[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

model Apartamento {
  id                   String                 @id @default(uuid())
  tenantId             String
  numero               String
  direccion            String?
  createAt             DateTime               @default(now())
  updateAt             DateTime               @updatedAt
  disponible           Boolean                @default(true)
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  apartamento          Habitaciones[]
  ApartamentoServicios ApartamentoServicios[]
  activo               Boolean
  Contratos            Contratos[]
  gastos               GastoApartamento[]

  @@unique([tenantId, numero])
  @@index([tenantId])
}

model Servicios {
  id                   String                 @id @default(uuid())
  tenantId             String
  nombre               String
  createAt             DateTime               @default(now())
  updateAt             DateTime               @updatedAt
  activo               Boolean
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  ApartamentoServicios ApartamentoServicios[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

model ApartamentoServicios {
  id             String      @id @default(uuid())
  tenantId       String
  apartamentoId  String
  servicioId     String
  incluido       Boolean     @default(true)
  costoAdicional Decimal     @default(0.00)
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  apartamento    Apartamento @relation(fields: [apartamentoId], references: [id])
  servicio       Servicios   @relation(fields: [servicioId], references: [id])
  createAt       DateTime    @default(now())
  updateAt       DateTime    @updatedAt

  @@unique([tenantId, apartamentoId, servicioId])
  @@index([tenantId])
  @@index([apartamentoId], map: "ApartamentoServicios_apartamentoId_fkey")
  @@index([servicioId], map: "ApartamentoServicios_servicioId_fkey")
}

model Contratos {
  id            String      @id @default(uuid())
  tenantId      String
  inquilinoId   String
  apartamentoId String
  fechaInicio   DateTime
  fechaFin      DateTime?
  createAt      DateTime    @default(now())
  updateAt      DateTime    @updatedAt
  montoMensual  Decimal     @default(0.00)
  activo        Boolean     @default(true)
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  inquilino     Inquilino   @relation(fields: [inquilinoId], references: [id])
  apartamento   Apartamento @relation(fields: [apartamentoId], references: [id])
  recibos       Recibos[]

  @@index([tenantId])
  @@index([inquilinoId], map: "Contratos_inquilinoId_fkey")
  @@index([apartamentoId], map: "Contratos_apartamentoId_fkey")
}

model Inquilino {
  id              String         @id @default(uuid())
  tenantId        String
  nombreCompleto  String
  dni             String
  numero          String
  correo          String
  fechaNacimiento DateTime       @db.DateTime(6) // armada a partir de "Dia"/"Mes"/"Año"
  createAt        DateTime       @default(now())
  updateAt        DateTime       @updatedAt
  activo          Boolean
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  Acompañante    Acompañante[]
  Contratos       Contratos[]

  @@unique([tenantId, dni])
  @@unique([tenantId, correo])
  @@index([tenantId])
}

model Recibos {
  id                    String                 @id @default(uuid())
  tenantId              String
  contratoId            String
  fechaPago             DateTime
  fechaVencimiento      DateTime
  estado                EstadoRecibo           @default(PENDIENTE)
  total                 Decimal                @default(0.00)
  cargoMora             Decimal                @default(0.00)
  saldoPendiente        Decimal                @default(0.00)
  observacionesCobranza String?
  createAt              DateTime               @default(now())
  updateAt              DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  contrato              Contratos              @relation(fields: [contratoId], references: [id])
  detalles              ReciboDetalles[]
  pagosParciales        PagoRecibo[]
  promesasPago          PromesaPago[]
  recordatorios         RecordatorioCobranza[]

  @@index([tenantId])
  @@index([contratoId], map: "Recibos_contratoId_fkey")
  @@index([estado, fechaVencimiento])
}

model ReciboDetalles {
  id          String   @id @default(uuid())
  tenantId    String
  reciboId    String
  descripcion String
  monto       Decimal  @default(0.00)
  createAt    DateTime @default(now())
  updateAt    DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  recibo      Recibos  @relation(fields: [reciboId], references: [id])

  @@index([tenantId])
  @@index([reciboId], map: "ReciboDetalles_reciboId_fkey")
}

model PagoRecibo {
  id         String   @id @default(uuid())
  tenantId   String
  reciboId   String
  fechaPago  DateTime
  monto      Decimal  @default(0.00)
  referencia String?
  nota       String?
  createAt   DateTime @default(now())
  updateAt   DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  recibo     Recibos  @relation(fields: [reciboId], references: [id])

  @@index([tenantId])
  @@index([reciboId])
}

model PromesaPago {
  id                String    @id @default(uuid())
  tenantId          String
  reciboId          String
  fechaPrometida    DateTime
  montoPrometido    Decimal   @default(0.00)
  nota              String?
  cumplida          Boolean   @default(false)
  fechaCumplimiento DateTime?
  createAt          DateTime  @default(now())
  updateAt          DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  recibo            Recibos   @relation(fields: [reciboId], references: [id])

  @@index([tenantId])
  @@index([reciboId])
  @@index([fechaPrometida])
}

model RecordatorioCobranza {
  id           String            @id @default(uuid())
  tenantId     String
  reciboId     String
  canal        CanalRecordatorio
  destinatario String
  mensaje      String
  enviadoAt    DateTime          @default(now())
  createAt     DateTime          @default(now())
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  recibo       Recibos           @relation(fields: [reciboId], references: [id])

  @@index([tenantId])
  @@index([reciboId])
  @@index([canal, enviadoAt])
}

enum EstadoRecibo {
  PENDIENTE
  PAGADO
  VENCIDO
  PARCIALMENTE_PAGADO
}

enum CanalRecordatorio {
  WHATSAPP
  EMAIL
}


model GastoApartamento {
  id              String         @id @default(uuid())
  tenantId        String
  apartamentoId   String
  fecha           DateTime
  categoria       CategoriaGasto
  concepto        String
  descripcion     String?
  monto           Decimal        @default(0.00)
  extraordinario  Boolean        @default(false)
  createAt        DateTime       @default(now())
  updateAt        DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  apartamento     Apartamento    @relation(fields: [apartamentoId], references: [id])

  @@index([tenantId])
  @@index([apartamentoId])
  @@index([fecha])
  @@index([categoria])
}

enum CategoriaGasto {
  MANTENIMIENTO
  REPARACION
  SERVICIO_DUENO
  LIMPIEZA
  MOBILIARIO
  COMISION
  IMPUESTO
  EXTRAORDINARIO
  OTRO
}

model Permiso {
  id               String       @id @default(uuid())
  tenantId         String
  nombre           String
  descripcion      String
  createAt         DateTime     @default(now())
  updateAt         DateTime     @updatedAt
  activo           Boolean
  esPermisoSistema Boolean      @default(false)
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  roles            RolPermiso[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

model RolPermiso {
  id        String   @id @default(uuid())
  tenantId  String
  rolId     String
  permisoId String
  createAt  DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  permiso   Permiso  @relation(fields: [permisoId], references: [id])
  rol       Rol      @relation(fields: [rolId], references: [id])

  @@unique([tenantId, rolId, permisoId])
  @@index([tenantId])
  @@index([permisoId], map: "RolPermiso_permisoId_fkey")
}

enum TipoUsuario {
  ROOT
  TENANT_ADMIN
}

model Usuario {
  id          String      @id @default(uuid())
  tenantId    String
  nombre      String
  email       String
  password    String
  createAt    DateTime    @default(now())
  updateAt    DateTime    @updatedAt
  activo      Boolean
  rolId       String
  DebeCambiar Boolean
  tipoUsuario TipoUsuario @default(TENANT_ADMIN)
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  rol         Rol         @relation(fields: [rolId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([rolId], map: "Usuario_rolId_fkey")
}
